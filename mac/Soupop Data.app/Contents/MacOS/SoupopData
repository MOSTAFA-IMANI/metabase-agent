#!/bin/bash
# Soupop Data: installs or updates the workspace in ~/soupop-data, then opens the launcher page.
REPO="https://github.com/MOSTAFA-IMANI/metabase-agent.git"
DIR="$HOME/soupop-data"
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:$PATH"

notice() {
  osascript -e "display dialog \"$1\" with title \"Soupop Data\" buttons {\"OK\"} default button 1" >/dev/null 2>&1
}

# git and python3 come with Apple's free command line tools.
if ! xcode-select -p >/dev/null 2>&1 || ! git --version >/dev/null 2>&1; then
  xcode-select --install >/dev/null 2>&1
  notice "Soupop Data needs Apple's free developer tools. Click Install in the window that opens, wait until it finishes, then open Soupop Data again."
  exit 0
fi

# Already running: just show the page again.
if [ -f "$DIR/.launcher-url" ]; then
  URL=$(cat "$DIR/.launcher-url")
  if curl -fs -o /dev/null --max-time 2 "$URL"; then
    open "$URL"
    exit 0
  fi
fi

if [ ! -d "$DIR/.git" ]; then
  if ! git clone -q "$REPO" "$DIR"; then
    notice "Soupop Data couldn't download its files. Check the internet connection and try again."
    exit 1
  fi
fi
cd "$DIR" || exit 1

# Stay identical to GitHub. Personal files (.env, settings, logs) are not tracked and are kept.
if git fetch -q origin; then
  BRANCH=main
  git rev-parse -q --verify origin/claude/workspace-v0 >/dev/null && BRANCH=claude/workspace-v0
  git checkout -q -f -B "$BRANCH" "origin/$BRANCH"
fi

if [ ! -f launcher/server.py ]; then
  notice "Soupop Data's files are incomplete. Ask the data team for help."
  exit 1
fi

rm -f .launcher-url
nohup python3 -u launcher/server.py >launcher.log 2>&1 &
for _ in $(seq 1 30); do
  [ -f .launcher-url ] && exit 0
  sleep 0.5
done
notice "Soupop Data didn't start. Send the file launcher.log in the soupop-data folder (in your home folder) to the data team."
exit 1
