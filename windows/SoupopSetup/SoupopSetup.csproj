<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SoupopSetup</AssemblyName>
    <RootNamespace>SoupopSetup</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Soupop Data Setup</Product>
    <Company>Soupop</Company>
    <Description>Sets up a Windows computer to use Codex with Soupop Metabase.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One self-contained .exe: staff need nothing else installed to run it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
